# Copy to .env next to docker-compose.yml.

# What browsers open: this container's public URL. Same value as PHPMYADMIN_URL in the panel's env.
PHPMYADMIN_URL=http://192.168.2.108:8081
# Host port to publish phpMyAdmin on (all interfaces).
PHPMYADMIN_PORT=8081

# The panel's public URL (Logout and error pages link back here).
PANEL_URL=https://panel.example.com
# How the container reaches the panel directly, bypassing any proxy auth in front of PANEL_URL.
PANEL_INTERNAL_URL=http://host.docker.internal:3001

# Shared secret, same value as PHPMYADMIN_SIGNON_SECRET in the panel's env.
# Generate with: openssl rand -base64 48
PHPMYADMIN_SIGNON_SECRET=

# Docker network wings puts game servers on (`docker network ls`; the one with 172.31.250.0/24).
WINGS_NETWORK=pterodactyl_nw

# Max import file size.
UPLOAD_LIMIT=128M
