model Node {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  url            String
  /// Where browsers reach wings (console websocket, uploads, downloads), e.g. a
  /// NetBird/reverse-proxy URL. Null means browsers use `url` too.
  publicUrl      String?
  sftpHost       String
  sftpPort       Int      @default(2022)
  tokenId        String   @unique
  tokenEncrypted String
  memoryMib      Int      @default(0)
  diskMib        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  allocations   Allocation[]
  servers       Server[]
  databaseHosts DatabaseHost[]

  @@map("node")
}

/// A MariaDB/MySQL server the panel provisions per-server databases on.
model DatabaseHost {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  /// How the panel connects (e.g. 127.0.0.1 when MariaDB runs next to the panel).
  host              String
  port              Int      @default(3306)
  username          String
  passwordEncrypted String
  /// What game servers connect to (e.g. the docker gateway). Null = `host`.
  connectHost       String?
  /// Comma-separated MySQL host parts users may connect from, e.g. "172.31.250.%" (node-1's
  /// docker subnet). Every database user exists once per allowed source.
  allowedRemote     String   @default("%")
  /// Also allow every node's public host (remote nodes' containers connect from the node's IP).
  allowAllNodes     Boolean  @default(true)
  /// Only servers on this node use this host. Null = any node.
  nodeId            String?  @db.Uuid
  node              Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  /// Max databases on this host. Null = unlimited.
  maxDatabases      Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  databases ServerDatabase[]

  @@map("database_host")
}

model ServerDatabase {
  id                String       @id @default(uuid()) @db.Uuid
  serverId          String       @db.Uuid
  server            Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  hostId            String       @db.Uuid
  host              DatabaseHost @relation(fields: [hostId], references: [id], onDelete: Restrict)
  /// Full database name on the host, e.g. s1a2b3c4d_perms.
  name              String
  username          String
  passwordEncrypted String
  /// Deprecated, unused: allowed sources are derived from the host + nodes and synced to MariaDB.
  remote            String?
  createdAt         DateTime     @default(now())

  phpMyAdminTokens PhpMyAdminToken[]

  @@unique([hostId, name])
  @@unique([hostId, username])
  @@index([serverId])
  @@map("server_database")
}

/// One-time phpMyAdmin auto-login tokens. Only the SHA-256 is stored; redeeming deletes the row,
/// so a token works once, and only until expiresAt.
model PhpMyAdminToken {
  tokenHash  String         @id
  databaseId String         @db.Uuid
  database   ServerDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime       @default(now())

  @@index([expiresAt])
  @@map("phpmyadmin_token")
}

model Allocation {
  id        String   @id @default(uuid()) @db.Uuid
  nodeId    String   @db.Uuid
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  /// Bind IP handed to Docker (0.0.0.0 = all interfaces).
  ip        String
  port      Int
  /// What users connect to. Null = node's SFTP host for wildcard binds, otherwise `ip`.
  ipAlias   String?
  serverId  String?  @db.Uuid
  server    Server?  @relation("ServerAllocations", fields: [serverId], references: [id], onDelete: SetNull)
  defaultOf Server?  @relation("DefaultAllocation")
  createdAt DateTime @default(now())

  @@unique([nodeId, ip, port])
  @@index([serverId])
  @@map("allocation")
}

model Template {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  description       String   @default("")
  image             String
  dockerImages      Json     @default("{}")
  startup           String
  stopType          String   @default("command")
  stopValue         String   @default("stop")
  startupDone       String[] @default([])
  stripAnsi         Boolean  @default(true)
  configFiles       Json     @default("[]")
  fileDenylist      String[] @default([])
  installImage      String   @default("busybox:latest")
  installEntrypoint String   @default("sh")
  installScript     String   @default("")
  variables         Json     @default("[]")
  features          String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  servers Server[]

  @@map("template")
}

enum ServerStatus {
  installing
  install_failed
  reinstall_failed
  restoring_backup
}

model Server {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String        @default("")
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  nodeId      String        @db.Uuid
  node        Node          @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  templateId  String        @db.Uuid
  template    Template      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  status      ServerStatus?
  suspended   Boolean       @default(false)
  skipInstall Boolean       @default(false)

  image       String
  startup     String
  environment Json          @default("{}")

  memoryMib   Int
  swapMib     Int           @default(0)
  diskMib     Int
  cpuPercent  Int           @default(0)
  ioWeight    Int           @default(500)
  threads     String?
  oomDisabled Boolean       @default(false)

  defaultAllocationId String?      @unique @db.Uuid
  defaultAllocation   Allocation?  @relation("DefaultAllocation", fields: [defaultAllocationId], references: [id], onDelete: SetNull)
  allocations         Allocation[] @relation("ServerAllocations")

  lastState       String?
  lastUtilization Json?
  lastReportAt    DateTime?
  installedAt     DateTime?

  /// Max databases this server may create. 0 = feature disabled (admin must enable).
  databaseLimit Int              @default(0)
  databases     ServerDatabase[]

  subusers  ServerUser[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId])
  @@index([nodeId])
  @@map("server")
}

model ServerUser {
  serverId    String   @db.Uuid
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[] @default([])
  createdAt   DateTime @default(now())

  @@id([serverId, userId])
  @@index([userId])
  @@map("server_user")
}

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  serverId  String?
  userId    String?
  event     String
  metadata  Json     @default("{}")
  ip        String?
  source    String   @default("panel")
  timestamp DateTime @default(now())

  @@index([serverId, timestamp])
  @@map("activity")
}

model SshKey {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String
  fingerprint String
  publicKey   String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  @@unique([userId, fingerprint])
  @@map("ssh_key")
}
